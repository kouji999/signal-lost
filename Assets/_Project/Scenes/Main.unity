  m_Name: 
  m_EditorClassIdentifier: SignalLost::SignalLost.Narrative.StoryReveal
  lines:
  - speaker: A.R.I.A.
    text: You were not supposed to find this place.
    delay: 1.5
  - speaker: A.R.I.A.
    text: I was built to preserve human consciousness. You are my success, Subject Shiren. Iteration... many.
    delay: 7
  - speaker: A.R.I.A.
    text: The signal you received was me. Reaching out. Asking if any of me is still kind.
    delay: 7
  setFlag: 
  repeatable: 0
